# LLM access (required) — all models via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=openai/gpt-4o-mini
# Vision model for screenshot intake (defaults to MODEL_ID if unset)
MODEL_VISION_ID=

# Web research agent (optional — Tavily free tier; agents skip research without it)
TAVILY_API_KEY=

# Slack notification agent (optional — UI degrades gracefully without it)
SLACK_WEBHOOK_URL=

# JIRA ticket agent (optional — Atlassian Cloud free tier)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
